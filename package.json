{
  "name": "teachingcareer",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev --prefix server\" \"npm:dev --prefix site\"",
    "seed": "npm run seed --prefix server",
    "install:all": "npm install --prefix server && npm install --prefix site",
    "build": "npm run build --prefix server && npm run build --prefix site",
    "start": "npm run start --prefix server"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
