PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/teachingcareer
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=5
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Used once by `npm run create-admin` to bootstrap the first admin account.
ADMIN_EMAIL=admin@teachingcareer.pk
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=TeachingCareer Admin
