PORT=4000
# Local dev default shown here. For MongoDB Atlas, use the connection string
# from Atlas's "Connect > Drivers" screen — standard form:
#   mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<app>
# If mongodb+srv:// fails to resolve on your host (a SRV DNS lookup issue,
# not a credentials issue — verify with `nslookup -type=SRV _mongodb._tcp.<cluster-host>`),
# use the direct (non-SRV) form instead: the three shard hosts from that SRV
# lookup, comma-separated, each with :27017, plus `replicaSet=<name>` from
# `nslookup -type=TXT <cluster-host>` and `authSource=admin&ssl=true`.
MONGODB_URI=mongodb://127.0.0.1:27017/teachingcareer
# The deployed frontend's origin — used for CORS and to build redirect URLs
# (password-reset links, Google OAuth callback fallback). Set this to the
# real production domain when deploying; nothing in the app should ever
# hardcode localhost itself.
CLIENT_ORIGIN=http://localhost:5174
MAX_UPLOAD_MB=5
NODE_ENV=development

# There's no real email provider wired up for password-reset links yet (see
# EXPOSE_DEV_RESET_URL below and routes/userAuth.ts), so this is required for
# local dev — without it, /auth/forgot-password has no way to hand you the
# reset link at all. Never set this to true on a real deployment: it makes
# every password-reset request return the raw reset token in the API
# response, and it stays off by default specifically so a misconfigured
# deployment fails closed rather than leaking tokens.
EXPOSE_DEV_RESET_URL=true

# Optional. Only read outside local dev — the path to the built React app
# that this server serves alongside the API. Defaults to server/dist/public,
# where site/vite.config.ts is configured to build the client (nested inside
# this app's own output directory rather than a sibling folder, so deploy
# tools that only keep a declared "output directory" — e.g. Hostinger's
# Node.js app import — don't discard it). Override only if your deployment
# layout puts the built client somewhere else.
CLIENT_DIST_PATH=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Used once by `npm run create-admin` to bootstrap the first super_admin
# account (a User document with role: super_admin — there is only one
# account system, see models/User.ts).
ADMIN_EMAIL=admin@teachingcareer.pk
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=TeachingCareer Admin

# Google Sign-In — optional. Leave unset and the "Continue with Google"
# button stays hidden (routes/userAuth.ts's /auth/google/status reports
# configured:false); nothing fakes a login while these are missing. Create
# an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (Web application type). GOOGLE_REDIRECT_URI must exactly match an
# "Authorized redirect URI" registered on that client — for local dev that's
# http://localhost:5174/api/auth/google/callback (Vite proxies /api to this
# server); for production, https://your-domain.com/api/auth/google/callback.
# If unset, it's derived from CLIENT_ORIGIN + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Outgoing contact-form email — optional. Every Contact page / footer
# submission is always saved to the database and visible in the admin
# dashboard regardless; this additionally emails a copy to
# CONTACT_RECIPIENT_EMAIL. Leave SMTP_USER/SMTP_PASS unset and sending is
# silently skipped (logged, never fails the visitor's submission).
#
# SMTP_USER/SMTP_PASS must be a real Gmail account's address and a 16-character
# App Password for it (NOT the account's normal login password — Google no
# longer accepts that for SMTP). Generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification to
# be turned on for that account first). itgraduate2025@gmail.com can be used
# as both the sending account and CONTACT_RECIPIENT_EMAIL below.
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=itgraduate2025@gmail.com
